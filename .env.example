# IAM Agent — configuration
#
# Copy to `.env` and fill in. `.env` is gitignored; this file is not, so never put a
# real secret here.
#
# Prefixes: IAM_ENTRA_, IAM_M365_, IAM_AD_, IAM_ACTION1_, IAM_SCALEFUSION_,
#           IAM_CLAUDE_, IAM_APPROVAL_, IAM_AUDIT_, IAM_API_, IAM_MOCK_
# Nested delimiter is `__`, e.g. IAM_APPROVAL__DEFAULT_MODE.
#
# NOTHING HERE IS REQUIRED TO RUN. Every platform falls back to a deterministic
# simulator, so `iam-agent status` and the full test suite work with an empty .env.
# Enable platforms one at a time and run `iam-agent preflight` after each.

# ---------------------------------------------------------------------------
# Global
# ---------------------------------------------------------------------------

# development | staging | production
IAM_ENVIRONMENT=development
IAM_LOG_LEVEL=INFO

# Master kill switch. When true, NOTHING is written to any platform regardless of
# every other setting below. Leave it true until you have watched a full dry-run
# onboarding and offboarding and are happy with the plans.
IAM_GLOBAL_DRY_RUN=true

# ---------------------------------------------------------------------------
# Execution mode — the safety contract
# ---------------------------------------------------------------------------

# dry_run          plan and simulate only; no writes, no approvals
# approval_required  reads are live, every write parks for a human   <-- recommended
# autonomous       writes proceed up to IAM_APPROVAL__AUTONOMOUS_MAX_RISK
IAM_APPROVAL__DEFAULT_MODE=approval_required

# Ceiling for autonomous mode. Anything riskier still gates. Critical actions
# ALWAYS gate, and always need two distinct approvers, in every mode.
IAM_APPROVAL__AUTONOMOUS_MAX_RISK=low

# How long an approval stays valid before it expires. Expired gates must be
# re-planned; they are never silently executed.
IAM_APPROVAL__REQUEST_TIMEOUT_MINUTES=60

# Require a second, *distinct* approver for critical actions (two-person integrity).
IAM_APPROVAL__REQUIRE_SECOND_APPROVER_FOR_CRITICAL=true

# Where the approval queue lives. Must be shared by every process that approves:
# the CLI, the API and the MCP server are separate processes and a gate parked by
# one must be visible to the others.
IAM_APPROVAL__STORAGE_PATH=data/approvals.jsonl

# Optional: POST each new approval request here (Slack, Teams, PagerDuty).
IAM_APPROVAL__NOTIFY_WEBHOOK_URL=

# ---------------------------------------------------------------------------
# Microsoft Entra ID  (cloud identity — the anchor object for every person)
# ---------------------------------------------------------------------------
# App registration needs, at minimum:
#   User.ReadWrite.All, Group.ReadWrite.All, Directory.ReadWrite.All,
#   AuditLog.Read, and UserAuthenticationMethod.ReadWrite.All for TAPs.
# See docs/PERMISSIONS.md for the full list per workflow.
IAM_ENTRA__ENABLED=false
IAM_ENTRA__BACKEND=mock
IAM_ENTRA__TENANT_ID=
IAM_ENTRA__CLIENT_ID=
IAM_ENTRA__CLIENT_SECRET=
# Certificate auth is preferred over a client secret in production.
IAM_ENTRA__CERTIFICATE_PATH=
IAM_ENTRA__CERTIFICATE_THUMBPRINT=
IAM_ENTRA__CERTIFICATE_PASSWORD=
# UPN domain for new users. If unset it is inferred from the supplied e-mail
# address, then from the tenant's default domain.
IAM_ENTRA__PRIMARY_DOMAIN=
# Entra ID Governance lifecycle workflows. Requires an Entra ID Governance licence,
# the Lifecycle Administrator role, and LifecycleWorkflows.ReadWrite.All.
IAM_ENTRA__ENABLE_LIFECYCLE_WORKFLOWS=true

# ---------------------------------------------------------------------------
# Microsoft 365  (mailboxes, Teams, licences, drives)
# ---------------------------------------------------------------------------
# Usually the same app registration as Entra, so these often mirror the values above.
IAM_M365__ENABLED=false
IAM_M365__BACKEND=mock
IAM_M365__TENANT_ID=
IAM_M365__CLIENT_ID=
IAM_M365__CLIENT_SECRET=

# Convert a leaver's mailbox to shared rather than deleting it. Strongly recommended:
# it preserves the data, releases the licence, and keeps a delegate able to read it.
IAM_M365__CONVERT_MAILBOX_TO_SHARED=true
# How long a shared mailbox is kept before the deferred-deletion job may remove it.
IAM_M365__SHARED_MAILBOX_RETENTION_DAYS=90
# Exchange Online PowerShell endpoint, used for the steps Graph cannot do
# (mailbox type change, FullAccess, litigation hold). Those return the exact cmdlet
# for a human to run.
IAM_M365__EXCHANGE_POWERSHELL_ENDPOINT=https://outlook.office365.com/powershell-liveid/
# Default licence SKUs if the workflow cannot derive them from the department.
# Comma-separated, e.g. ENTERPRISEPACK,EMS
IAM_M365__DEFAULT_LICENSE_SKUS=

# ---------------------------------------------------------------------------
# Active Directory (on-premises)
# ---------------------------------------------------------------------------
# IMPORTANT: on-prem AD is frequently the SOURCE OF AUTHORITY for synced accounts.
# Disabling only in Entra is not a disable — the next sync re-enables the cloud
# object. The offboarding workflow handles both sides.
#
# Password writes require LDAPS. `unicodePwd` must be sent over an encrypted
# channel; a plaintext bind on port 389 will be refused by the domain controller.
IAM_AD__ENABLED=false
IAM_AD__BACKEND=mock
# Comma-separated, e.g. dc01.corp.local,dc02.corp.local
# Both IAM_AD__SERVERS and IAM_AD_SERVERS are accepted; every other section also
# accepts IAM_<SECTION>__<FIELD> and IAM_<SECTION>_<FIELD>. `iam-agent preflight`
# reports any IAM_* variable that matches no setting, so a typo is never silent.
IAM_AD__SERVERS=
IAM_AD__PORT=636
IAM_AD__USE_SSL=true
IAM_AD__TLS_VALIDATE=true
IAM_AD__CA_CERTS_FILE=
# Use a dedicated gMSA or service account with the minimum rights: read the tree,
# write only inside the user OUs below. Do not use a Domain Admin account.
IAM_AD__BIND_USER=
IAM_AD__BIND_PASSWORD=
IAM_AD__BASE_DN=DC=corp,DC=local
IAM_AD__USERS_OU=OU=Users,DC=corp,DC=local
IAM_AD__GROUPS_OU=OU=Groups,DC=corp,DC=local
# Where disabled accounts are moved. Keeping them in a separate OU makes the
# leaver population auditable at a glance.
IAM_AD__DISABLED_OU=OU=Disabled,DC=corp,DC=local
IAM_AD__DOMAIN_NETBIOS=CORP
IAM_AD__UPN_SUFFIX=@corp.local
IAM_AD__CONNECT_TIMEOUT=10
IAM_AD__RECEIVE_TIMEOUT=30

# Hard-deleting an AD object is irreversible and removes the security principal's
# history. Offboarding disables and moves; it does not delete. Leave this false
# unless you have a specific, approved reason.
IAM_AD__ALLOW_HARD_DELETE=false

# ---------------------------------------------------------------------------
# Action1  (Windows PCs and servers — RMM)
# ---------------------------------------------------------------------------
# Create credentials in the Action1 console: Configuration → Users & API Credentials
# → "+ New API Credentials". The secret is shown ONCE.
# OAuth2 client-credentials; the JWT lasts 3600s and is refreshed 120s early.
IAM_ACTION1__ENABLED=false
IAM_ACTION1__BACKEND=mock
IAM_ACTION1__CLIENT_ID=
IAM_ACTION1__CLIENT_SECRET=
# north_america | europe | australia. Determines the API host unless BASE_URL is set.
IAM_ACTION1__REGION=europe
IAM_ACTION1__BASE_URL=
IAM_ACTION1__ORGANIZATION_ID=
# Endpoint groups used to stage joiners and contain leavers.
IAM_ACTION1__JOINER_GROUP_ID=
IAM_ACTION1__LEAVER_GROUP_ID=
# Automations to run at onboarding/offboarding, e.g. install the standard toolset.
IAM_ACTION1__ONBOARDING_AUTOMATION_ID=
IAM_ACTION1__OFFBOARDING_AUTOMATION_ID=

# Rebooting or shutting down a machine is disruptive and can lose unsaved work.
# Off by default; containment is achieved by moving the endpoint to the leaver group.
IAM_ACTION1__ALLOW_REMOTE_REBOOT=false
IAM_ACTION1__ALLOW_REMOTE_SHUTDOWN=false

# ---------------------------------------------------------------------------
# Scalefusion  (mobile — MDM)
# ---------------------------------------------------------------------------
# Dashboard → Integrations → Developer API → Generate API Key. Regenerating the key
# DISABLES the previous one. The API is CORS-blocked, so it must be called from this
# backend, never from a browser.
#
# Rate limits: 30 requests/minute and 43,200 requests/day. The values below are used
# by the built-in rate limiter; do not raise them above your plan's limits.
IAM_SCALEFUSION__ENABLED=false
IAM_SCALEFUSION__BACKEND=mock
IAM_SCALEFUSION__API_KEY=
IAM_SCALEFUSION__BASE_URL=https://api.scalefusion.com
IAM_SCALEFUSION__RATE_LIMIT_PER_MINUTE=30
IAM_SCALEFUSION__REQUEST_TIMEOUT=30
IAM_SCALEFUSION__DEVICES_API_VERSION=v2
# Verify the auth header against the Scalefusion API Explorer for your account; the
# header name and prefix are not documented consistently across their plans.
IAM_SCALEFUSION__AUTH_HEADER_NAME=Authorization
IAM_SCALEFUSION__AUTH_HEADER_PREFIX=Bearer 
# Profile applied to new joiners, and the restrictive profile applied to leavers.
IAM_SCALEFUSION__DEVICE_PROFILE_ID=
IAM_SCALEFUSION__LEAVER_DEVICE_PROFILE_ID=
IAM_SCALEFUSION__DEVICE_GROUP_ID=
# Wiping and retiring are destructive. They always gate on approval even when true.
# BYOD devices are never fully wiped regardless of these flags — work profile only.
IAM_SCALEFUSION__ALLOW_WIPE=true
IAM_SCALEFUSION__ALLOW_RETIRE=true

# ---------------------------------------------------------------------------
# Autonomous agent  (Anthropic API)
# ---------------------------------------------------------------------------
# Only needed for `iam-agent agent`. The MCP server, the REST API and the rest of the
# CLI need NO model API key — your own Claude drives those.
IAM_CLAUDE__ENABLED=false
IAM_CLAUDE__API_KEY=
IAM_CLAUDE__MODEL=claude-sonnet-4-5
IAM_CLAUDE__MAX_TOKENS=8192
# Keep at 0 for deterministic infrastructure work.
IAM_CLAUDE__TEMPERATURE=0.0
# Operator-maintained instructions. Resolved relative to the repo root, so the agent
# finds it whatever directory it was started from.
IAM_CLAUDE__SYSTEM_PROMPT_PATH=config/system_prompt.md
IAM_CLAUDE__MAX_TURNS=25

# ---------------------------------------------------------------------------
# Audit
# ---------------------------------------------------------------------------
# Append-only. Treat as a compliance record: back it up, and do not let the process
# user have delete rights on it.
IAM_AUDIT__LOG_PATH=data/audit.jsonl
IAM_AUDIT__RUN_STORE_PATH=data/runs
IAM_AUDIT__INCLUDE_REQUEST_PAYLOADS=true
# Extra field names to mask, comma-separated. Left COMMENTED OUT on purpose: this
# setting REPLACES the shipped list rather than adding to it, so an empty value
# would silently remove access_token, refresh_token, bind_password and
# temporaryAccessPass from redaction. Built-in redaction in core/redact.py always
# applies regardless; this only extends the audit-log field list.
# IAM_AUDIT__REDACT_FIELDS=password,client_secret,api_key,certificate_password,bind_password,access_token,refresh_token,temporaryAccessPass

# ---------------------------------------------------------------------------
# REST API
# ---------------------------------------------------------------------------
IAM_API__HOST=0.0.0.0
IAM_API__PORT=8000
IAM_API__CORS_ORIGINS=

# REQUIRED in anything but a local sandbox. Protects POST /approvals/{id}/decision,
# which is the human-in-the-loop gate. Without a token, anything that can reach the
# port can approve its own changes.
IAM_API__API_TOKEN=

# HMAC-SHA256 secrets for the inbound webhooks. When set, an unsigned or badly
# signed request is rejected — an unauthenticated leaver event is a denial-of-service
# vector against your own staff. Generate with: openssl rand -hex 32
IAM_API__HR_WEBHOOK_SECRET=
IAM_API__SCALEFUSION_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Simulator
# ---------------------------------------------------------------------------
# Persist the simulated estate to disk so the CLI, API and MCP server share one view.
# Without this, a user created by `iam-agent onboard --execute` does not exist for the
# `iam-agent approvals decide` that follows it, because those are separate processes.
IAM_MOCK__PERSIST=true
IAM_MOCK__PERSIST_PATH=data/mock_estate.json
